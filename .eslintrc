{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:@typescript-eslint/recommended-requiring-type-checking",
    "plugin:prettier/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 12,
    "sourceType": "module",
    "project": "./tsconfig.json"
  },
  "plugins": ["react", "@typescript-eslint", "ssr-friendly"],
  "ignorePatterns": ["dist/", "node_modules/", ".next/", "out/"],
  "rules": {
    "ssr-friendly/no-dom-globals-in-module-scope": "error",
    "ssr-friendly/no-dom-globals-in-constructor": "error",
    "ssr-friendly/no-dom-globals-in-react-cc-render": "warn",
    "ssr-friendly/no-dom-globals-in-react-fc": "warn"
  }
}
